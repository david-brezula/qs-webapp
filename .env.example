# ── Database (Supabase) ─────────────────────────────────────────────────────
# Transaction pooler URL (port 6543) — used by the app at runtime.
# Username is `postgres.[project-ref]`. `pgbouncer=true` and a low
# connection_limit are required because the pooler is in transaction mode.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) — used by Prisma CLI for migrations only.
# Migrations against the pgbouncer pooler fail (advisory locks, prepared
# statements); always run `prisma migrate deploy` with DIRECT_URL set.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# Restricted RLS-enforced role used by the worker-facing wages page. Connect
# via the same pooler host but as `qs_worker.[project-ref]`. Password is set
# by scripts/setup-rls-role.sql (run once after migrate deploy).
DATABASE_URL_WORKER="postgresql://qs_worker.[project-ref]:[worker-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"

# Must match your production domain exactly
NEXTAUTH_URL="https://quantumsphere.eu"

# Host split (production) — used by proxy.ts
NEXT_PUBLIC_SITE_URL=https://quantum-sphere.eu
NEXT_PUBLIC_APP_URL=

# ── First-run admin seed (only read by `prisma db seed`) ────────────────────
# Used once when seeding the production database. Pick a strong password,
# then rotate it from the admin UI after first login.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@quantumsphere.eu"
SEED_ADMIN_PASSWORD="replace-with-a-strong-temporary-password"

# ── Contact-form email notifications (optional — omit to disable) ───────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@quantumsphere.eu"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Quantum Sphere <noreply@quantumsphere.eu>"
CONTACT_NOTIFY_EMAIL="info@quantumsphere.eu"

# Supabase Storage (client-portal photos/documents) — server-only
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_FILES_BUCKET=project-files
