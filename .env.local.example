DATABASE_URL="postgresql://qs:qs_local_dev@localhost:5432/qs_web?schema=public"
# Direct connection used by Prisma CLI for migrations. Locally this is the
# same as DATABASE_URL; on Supabase it is the port-5432 db.[ref] host while
# DATABASE_URL is the port-6543 pooler host.
DIRECT_URL="postgresql://qs:qs_local_dev@localhost:5432/qs_web?schema=public"
# Restricted, RLS-enforced role for the worker-facing wages page. Same
# database as DATABASE_URL, authenticating as the `qs_worker` role created by
# scripts/setup-rls-role.sql. In production (Supabase) the pooled username is
# `qs_worker.[project-ref]`.
DATABASE_URL_WORKER="postgresql://qs_worker:CHANGE_ME@localhost:5432/qs_web?schema=public"
AUTH_SECRET="generate with: openssl rand -base64 32"

# Email notifications for contact form (optional — omit to disable)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@quantumsphere.eu
SMTP_PASS=your-smtp-password
SMTP_FROM="Quantum Sphere <noreply@quantumsphere.eu>"
CONTACT_NOTIFY_EMAIL=info@quantumsphere.eu

# Public site origin — used for canonical URLs, hreflang, sitemap, robots, OG
# images and JSON-LD. Defaults to https://quantum-sphere.eu when unset; override
# for local dev or preview environments.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: absolute-from-root path to a rasterized Organization logo in /public
# (e.g. /logo.png). Omitted from JSON-LD when unset so no broken URL is emitted.
# NEXT_PUBLIC_ORG_LOGO_URL=/logo.png
